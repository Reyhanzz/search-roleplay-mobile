<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/srp_bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/srp_crimson"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/srp_loading_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="@dimen/_105sdp"
            android:layout_height="@dimen/_105sdp"
            android:contentDescription="Search Roleplay"
            app:srcCompat="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/bebas_neue"
            android:letterSpacing="0.06"
            android:text="SEARCH ROLEPLAY"
            android:textColor="@color/srp_text_main"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/barlow_semibold"
            android:letterSpacing="0.12"
            android:text="OPEN.MP  |  CONNECTING TO LOS SANTOS"
            android:textColor="@color/srp_gold"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/progressBar2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="@dimen/_230sdp"
            android:layout_height="6dp"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/srp_crimson" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
