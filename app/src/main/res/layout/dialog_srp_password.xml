<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/srp_card_gold_bg"
    android:orientation="vertical"
    android:padding="1dp">

    <!-- Top 2dp Gold Accent Strip -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/srp_gold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header: Gold Lock Crest + Eyebrow + Display Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/srp_crest_gold_bg">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_srp_lock"
                    android:tint="@color/srp_gold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pw_dlg_eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_semibold"
                    android:letterSpacing="0.06"
                    android:text="PRIVATE ACCESS  •  SERVER LOCKED"
                    android:textColor="@color/srp_gold"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/pw_dlg_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bebas_neue"
                    android:letterSpacing="0.03"
                    android:text="ENTER SERVER PASSWORD"
                    android:textColor="@color/srp_text_main"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Live Server Context Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/srp_rail_box_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="10dp"
            android:paddingBottom="9dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pw_dlg_hostname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_semibold"
                    android:maxLines="1"
                    android:text="SEARCH ROLEPLAY"
                    android:textColor="@color/srp_text_main"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pw_dlg_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="monospace"
                    android:text="151.246.170.113:7777"
                    android:textColor="@color/srp_text_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/srp_pill_gold"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_srp_lock"
                    android:tint="@color/srp_gold" />

                <TextView
                    android:id="@+id/pw_dlg_locked_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/barlow_semibold"
                    android:text="LOCKED"
                    android:textColor="@color/srp_gold"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Field Label Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pw_dlg_field_lbl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/barlow_semibold"
                android:text="SERVER PASSWORD"
                android:textColor="@color/srp_text_sec"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/pw_dlg_field_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_regular"
                android:text="Required to join"
                android:textColor="@color/srp_text_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Recessed Input Container with Key Icon & Eye Toggle -->
        <LinearLayout
            android:id="@+id/pw_dlg_input_box"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/srp_input_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/pw_dlg_key_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_srp_key"
                android:tint="@color/srp_text_muted" />

            <EditText
                android:id="@+id/pw_dlg_edit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/barlow_medium"
                android:hint="Enter server password..."
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/srp_text_main"
                android:textColorHint="@color/srp_text_muted"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/pw_dlg_eye_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Show or hide password"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_srp_eye"
                android:tint="@color/srp_text_muted" />
        </LinearLayout>

        <!-- Inline Error Feedback -->
        <TextView
            android:id="@+id/pw_dlg_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/barlow_semibold"
            android:minHeight="18dp"
            android:text=""
            android:textColor="@color/srp_crimson_hover"
            android:textSize="11.5sp" />

        <!-- Remember Password Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/pw_dlg_remember"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/srp_gold"
                android:fontFamily="@font/barlow_regular"
                android:text="Remember password for this server"
                android:textColor="@color/srp_text_sec"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/pw_dlg_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_semibold"
                android:padding="4dp"
                android:text="Clear saved"
                android:textColor="@color/srp_text_muted"
                android:textSize="11.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/srp_border" />

        <!-- Footer Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pw_dlg_btn_cancel"
                android:layout_width="96dp"
                android:layout_height="42dp"
                android:background="@drawable/srp_btn_ghost"
                android:fontFamily="@font/barlow_semibold"
                android:gravity="center"
                android:text="Cancel"
                android:textColor="@color/srp_text_sec"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/pw_dlg_btn_join"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/srp_btn_crimson"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_srp_unlock"
                    android:tint="@color/srp_text_main" />

                <TextView
                    android:id="@+id/pw_dlg_btn_join_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/bebas_neue"
                    android:letterSpacing="0.05"
                    android:text="UNLOCK &amp; PLAY"
                    android:textColor="@color/srp_text_main"
                    android:textSize="19sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
